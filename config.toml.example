# 1MCP Application Configuration
# Copy this file to ~/.config/1mcp/config.toml and adjust as needed.
# CLI arguments and ONE_MCP_* environment variables always take precedence over these values.
# Changes to this file require a process restart to take effect.

# Transport type: "http" | "sse" | "stdio"
transport = "http"

# HTTP port to listen on
port = 3050

# HTTP host to listen on
host = "127.0.0.1"

# Log level: "debug" | "info" | "warn" | "error"
logLevel = "info"

# Path to log file (optional)
# logFile = "/var/log/1mcp.log"

[auth]
# Enable OAuth 2.1 authentication
enabled = false

# Session TTL in minutes
sessionTtl = 1440

# Rate limit window in minutes
rateLimitWindow = 15

# Maximum requests per rate limit window
rateLimitMax = 100

# Trust proxy configuration for Express.js
trustProxy = "loopback"

# Enable tag-based scope validation
# enableScopeValidation = false

# Enable enhanced security middleware
# enableEnhancedSecurity = false

[asyncLoading]
# Enable asynchronous MCP server loading
enabled = false

# Maximum concurrent backend loads
maxConcurrentLoads = 5

# Foreground retries after the initial attempt (0 = no retries)
maxRetries = 3

# Initial retry delay in milliseconds (0 = immediate finite retries)
retryDelay = 2000

# Deprecated compatibility options; accepted but do not affect readiness.
# minServers = 1
# timeout = 30000

# Batch capability change notifications
# batchNotifications = false

# Batch delay in milliseconds
# batchDelay = 100

[asyncLoading.backgroundRetry]
# Retry failed backends in the background
enabled = true

# Retry interval in milliseconds (minimum 1000)
interval = 60000

# Maximum failed backends processed per cycle
maxServersPerCycle = 3

[admin.rateLimit.login]
windowSeconds = 900
maxRequests = 30
maxFailedAttempts = 5

[admin.rateLimit.status]
windowSeconds = 60
maxRequests = 120

[admin.rateLimit.sensitive]
windowSeconds = 900
maxRequests = 10

[admin.audit]
# Sanitized audit fact retention; idempotency retention remains fixed
retentionDays = 30

[health.rateLimit]
windowSeconds = 300
maxRequests = 200

[templateSettings.pool]
# Zero removes the per-template limit but not the mandatory global limit
maxInstancesPerTemplate = 50
maxTotalInstances = 100

# Milliseconds; zero idle timeout makes an unused instance immediately eligible
idleTimeout = 300000
cleanupInterval = 30000

[lazyLoading]
# Opt in to stable meta-tool exposure for progressive discovery. When false
# (the default), all tools are exposed directly.
enabled = false

# Maximum tool schemas to cache
# cacheMaxEntries = 1000

# Include full tool catalog in initialize template
# inlineCatalog = false

[configReload]
# Enable automatic mcp.json hot-reload
enabled = true

# Debounce delay in milliseconds
debounce = 500
